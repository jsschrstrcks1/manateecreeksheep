#!/bin/sh
# pre-push — mcs-privacy-attestation-parity (2026-08-18, ported from OCS canonical).
# Enable once per clone:  git config core.hooksPath .githooks
# (arm-hooks-path.sh SessionStart hook does this automatically in agent sessions.)
ROOT="$(git rev-parse --show-toplevel)"

# Gate 1: this repo must be confirmed PRIVATE before anything leaves the machine —
# it carries family names, farm operations, and health data.
#   Guard logic + override docs: tools/assert-repo-private.sh
"$ROOT/tools/assert-repo-private.sh" || exit $?

# Gate 2: never force / non-fast-forward / delete a PROTECTED branch (ported gate).
PROTECTED_RE='^refs/heads/(main|master|prod|production|release)$'
block=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  echo "$remote_ref" | grep -Eq "$PROTECTED_RE" || continue
  if echo "$local_sha" | grep -Eq '^0+$'; then
    echo "pre-push: refusing to DELETE protected branch $remote_ref" >&2; block=1; continue
  fi
  echo "$remote_sha" | grep -Eq '^0*$' && continue
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing NON-FAST-FORWARD (force) push to protected $remote_ref" >&2
    block=1
  fi
done
[ "$block" -eq 0 ] || exit 1
exit 0
