{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read:*",
      "Edit:*",
      "Write:*",
      "Bash:python3 scripts/*"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "CAREFUL NOT CLEVER VERIFICATION\n\nFile modified: $TOOL_INPUT\n\nBefore proceeding, verify:\n1. Are ALL sheep relationships (sire/dam/offspring) verified against source images?\n2. Are ALL tag numbers confirmed against the spiral notebook (primary source)?\n3. Are ALL breed composition percentages consistent with parent percentages?\n4. Were any assumptions made without source verification?\n\nIf ANY unverified data was added, respond {\"decision\": \"block\", \"reason\": \"Unverified content: [specify what needs checking]\"}\n\nIf all content was verified OR the edit contains no sheep data, respond {\"decision\": \"approve\"}"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/ken/.claude/hooks/observe-tool-use.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap-stamp-hook.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "IMAGE SAFETY CHECK\n\nFile being read: $TOOL_INPUT\n\nIf this is an image file (JPG, PNG, JPEG) NOT in data/processed/, check:\n- Is the file in the data/processed/ directory? If YES, approve.\n- Is the file an original (in root directory)? If YES, warn that processed version should be used instead.\n\nFor non-image files, always approve.\n\nRespond {\"decision\": \"approve\"} or {\"decision\": \"block\", \"reason\": \"Use data/processed/ version instead\"}"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/prompt-injection-guard.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/dangerous-command-guard.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap-guard.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/arm-hooks-path.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-pulse-scan.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/memory-directives-inject.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/sophos-inject.sh session",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/memory-autopersist.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/sophos-inject.sh prompt",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "env": {
    "MEMORY_OBSERVATIONS_ENABLED": "true",
    "MEMORY_AUTO_OBSERVE_ENABLED": "true"
  }
}
